# TODO: provision separate credentials for deployment.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
APP_ROOT_PATH=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=lms-local
DB_ECHO_LOG=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=5
DB_COMMAND_TIMEOUT=5
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT=2
# TODO: provision and rotate the deployment JWT signing key.
# TokenService requires SECRET_KEY; this value is a local example.
SECRET_KEY=replace-this-development-key-before-deploying
JWT_ALGORITHM=HS256
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
ACCESS_TOKEN_EXPIRE_SECONDS=900
# List settings use JSON arrays, not comma-separated strings.
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false
